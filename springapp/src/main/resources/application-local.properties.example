# Copy this file to application-local.properties and fill in your existing local values.
# application-local.properties is ignored by Git.
DB_URL=jdbc:mysql://localhost:3306/newprojectdb?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=YOUR_LOCAL_MYSQL_PASSWORD
MAIL_USERNAME=YOUR_EXISTING_MAIL_USERNAME
MAIL_PASSWORD=YOUR_EXISTING_MAIL_PASSWORD
GEMINI_API_KEY=YOUR_EXISTING_GEMINI_KEY
